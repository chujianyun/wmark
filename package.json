{
  "name": "wmark",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "tauri": "tauri",
    "test:core": "cargo test -p wmark-core",
    "check": "npm run typecheck && npm test && cargo test --workspace && cargo clippy --workspace --all-targets -- -D warnings",
    "desktop:build": "tauri build"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1",
    "@tanstack/react-virtual": "^3",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "lucide-react": "^0.468",
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^6",
    "@testing-library/react": "^16",
    "@testing-library/user-event": "^14",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5",
    "jsdom": "^26",
    "prettier": "^3.9.6",
    "typescript": "^5.9",
    "vite": "^7",
    "vitest": "^3"
  }
}
